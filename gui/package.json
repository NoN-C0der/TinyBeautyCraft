{
  "name": "tiny-mc-gui",
  "version": "1.0.0",
  "description": "Tiny MC Launcher - Graphical User Interface with Electron + React + Redux",
  "main": "main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run electron:build",
    "dist:win:ia32": "npm run build && electron-builder --win --ia32",
    "dist:win:all": "npm run build && electron-builder --win --ia32 --x64",
    "rebuild": "node-gyp rebuild || echo \"No native modules to rebuild\"",
    "install-deps": "npm install --legacy-peer-deps",
    "clean": "rimraf dist && rimraf node_modules/.vite",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write .",
    "postinstall": "npm run rebuild"
  },
  "author": "qwq672",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "@reduxjs/toolkit": "^2.2.1",
    "axios": "^1.6.7",
    "chart.js": "^4.4.1",
    "cross-env": "^7.0.3",
    "electron-log": "^5.0.1",
    "electron-updater": "^6.1.7",
    "framer-motion": "^11.0.5",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.1",
    "recharts": "^2.12.2",
    "redux-persist": "^6.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "node-gyp": "^10.0.1",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.qwq672.tinymc",
    "productName": "Tiny MC Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "package.json",
      "!**/node_modules/.cache",
      "!**/.vscode"
    ],
    "extraResources": [
      {
        "from": "public/",
        "to": "public/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.ico",
      "publisherName": "qwq672",
      "legalTrademarks": "Tiny MC Launcher"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "Tiny MC Launcher",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "Tiny MC Launcher",
      "uninstallDisplayName": "${productName} ${version}",
      "license": "LICENSE.txt",
      "deleteAppDataOnUninstall": false
    },
    "compression": "normal",
    "removePackageScripts": true,
    "asar": true,
    "asarUnpack": [],
    "electronVersion": "29.1.0",
    "npmRebuild": true,
    "buildDependenciesFromSource": false
  }
}
